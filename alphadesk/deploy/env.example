# AlphaDesk configuration — copy to the repo root as .env and fill in.
# Nothing here is secret by default; if you add keys, chmod 600 .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Providers: which plugin serves each seam ─────────────────────────────────
# See docs/providers.md. /api/system reports what's registered vs selected.
LLM_PROVIDER=openai-compatible     # or: anthropic
NEWS_PROVIDER=polygon              # or: alpaca
PRICE_PROVIDER=builtin             # alpaca quotes/bars + yfinance company data

# ── LLM ───────────────────────────────────────────────────────────────────────
# openai-compatible works with DeepSeek, OpenAI, Groq, Together, LM Studio,
# Ollama — it's a base URL and a model name, not different code.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
#   OpenAI :  https://api.openai.com/v1        gpt-4o-mini
#   Ollama :  http://localhost:11434/v1        llama3.1        (no key needed)
#   Claude :  LLM_PROVIDER=anthropic           claude-sonnet-4-5

# ── Market data (Alpaca free tier is enough to start) ────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── News ─────────────────────────────────────────────────────────────────────
# Only needed for NEWS_PROVIDER=polygon. The alpaca provider reuses the
# ALPACA_* keys above and costs nothing extra.
POLYGON_API_KEY=

# ── SEC EDGAR (no key — but a contact address is REQUIRED) ───────────────────
# SEC throttles or blocks generic User-Agents. Use your own address: it
# identifies YOUR deployment's traffic, not the project's.
SEC_USER_AGENT=AlphaDesk (you@example.com)

# ── Server ───────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1           # 0.0.0.0 when serving beyond localhost
DASHBOARD_PORT=8000
ALPHADESK_DATA=~/.alphadesk        # ledger.db + the tradable-universe cache

# ── Ingest cadence ───────────────────────────────────────────────────────────
NEWS_REFRESH_MINUTES=20
NEWS_LOOKBACK_HOURS=36
SCREENER_HORIZON_DAYS=5            # how far ahead the earnings window looks

# ── AI input budgets (per call, in characters) ───────────────────────────────
LLM_MAX_INPUT_CHARS=24000          # default, sized for batched headlines
SCREENER_ASK_MAX_CHARS=40000       # one ask spans the whole window
SCREENER_ASK_MAX_ARTICLES=120      # oldest dropped first
FILING_MAX_CHARS=60000             # a 10-K's narrative runs long
RESEARCH_MAX_CHARS=30000
RESEARCH_CACHE_TTL_HOURS=4         # the DATA ages, not just the question

# ── Chart honesty (see the README) ───────────────────────────────────────────
# Below either floor, indicators are HIDDEN rather than drawn on data too
# sparse to support them.
CHART_MIN_COVERAGE=0.5             # share of a full 390-bar session
CHART_MAX_MEDIAN_GAP_MIN=2.0

# ── Third-party plugins (optional) ───────────────────────────────────────────
# Comma-separated import paths; importing is enough, they register themselves.
# Installed packages exposing the `alphadesk.providers` entry point are found
# automatically and need no entry here.
ALPHADESK_PLUGINS=
